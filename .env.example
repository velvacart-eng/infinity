# ---- Contact form email (app/api/contact/route.ts) ----
# Submissions are sent to CONTACT_TO via SMTP.
# SMTP server. For Gmail use smtp.gmail.com, for Outlook smtp.office365.com, etc.
SMTP_HOST=smtp.gmail.com
# 587 for STARTTLS, 465 for SSL
SMTP_PORT=587
# The mailbox that SENDS the email. For Gmail this must be the account email.
SMTP_USER=your-sending-email@gmail.com
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Regular account passwords will NOT work.
SMTP_PASS=your-app-password
# Where submissions are delivered (defaults to vijay0262@gmail.com)
CONTACT_TO=vijay0262@gmail.com
# Optional: From header. Defaults to SMTP_USER. Some providers require it to equal SMTP_USER.
CONTACT_FROM=
